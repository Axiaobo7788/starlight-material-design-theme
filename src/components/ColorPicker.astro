			const colorArea = this.querySelector<HTMLElement>('.md3-color-picker__sv');
			const preview = this.querySelector<HTMLElement>('.md3-color-picker__preview');
			const hue = this.querySelector<HTMLInputElement>('.md3-color-picker__hue');
			const saturation = Math.round(this.color.saturation * 100);
			const brightness = Math.round(this.color.value * 100);

			if (colorArea) {
				colorArea.style.setProperty('--md3-picker-hue', `hsl(${this.color.hue} 100% 50%)`);
				colorArea.style.setProperty('--md3-picker-saturation', `${saturation}%`);
