---
import { Icon } from '@astrojs/starlight/components';

const language = Astro.currentLocale?.toLowerCase() ?? '';
const isChinese = language.startsWith('zh');
const labels = isChinese
	? {
			title: '主题颜色',
			close: '关闭主题颜色',
			source: '颜色来源',
			default: '默认',
			custom: '自定义',
			seed: '种子颜色',
			colorArea: '颜色饱和度和明度',
			saturation: '饱和度',
			brightness: '明度',
			hue: '色相',
			variant: '色板风格',
			tonalSpot: '柔和',
			expressive: '灵动',
			content: '原色',
			reset: '重置',
			cancel: '取消',
			apply: '应用',
			copy: '复制配置',
			copied: '配置已复制',
			invalid: '请输入有效的十六进制颜色。',
		}
	: {
			title: 'Theme color',
			close: 'Close theme color',
			source: 'Color source',
			default: 'Default',
			custom: 'Custom',
			seed: 'Seed color',
			colorArea: 'Color saturation and brightness',
			saturation: 'Saturation',
			brightness: 'Brightness',
			hue: 'Hue',
			variant: 'Palette style',
			tonalSpot: 'Tonal spot',
			expressive: 'Expressive',
			content: 'Content',
			reset: 'Reset',
			cancel: 'Cancel',
			apply: 'Apply',
			copy: 'Copy config',
			copied: 'Configuration copied',
			invalid: 'Enter a valid hex color.',
		};
---

<starlight-md3-color-picker>
	<button
		type="button"
		class="md3-color-picker__trigger"
		aria-haspopup="dialog"
		aria-expanded="false"
		aria-label={labels.title}
		title={labels.title}
	>
		<span class="md3-color-picker__swatch" aria-hidden="true"></span>
		<span class="md3-color-picker__trigger-label">{labels.title}</span>
		<Icon name="right-caret" class="md3-color-picker__trigger-caret" />
	</button>

	<dialog class="md3-color-picker__dialog" aria-label={labels.title}>
		<div class="md3-color-picker__sheet-handle" aria-hidden="true"></div>
		<header class="md3-color-picker__header">
			<h2>{labels.title}</h2>
			<button type="button" class="md3-color-picker__close" aria-label={labels.close} title={labels.close}>
				<Icon name="close" />
			</button>
		</header>

		<div class="md3-color-picker__content">
			<fieldset class="md3-color-picker__group md3-color-picker__source-group">
				<legend>{labels.source}</legend>
				<div class="md3-color-picker__segments md3-color-picker__segments--source">
					<label>
						<input type="radio" name="md3-color-source" value="default" />
						<span>
							<Icon name="approve-check" class="md3-color-picker__segment-check" aria-hidden="true" />
							<span class="md3-color-picker__segment-label">{labels.default}</span>
						</span>
					</label>
					<label>
						<input type="radio" name="md3-color-source" value="custom" />
						<span>
							<Icon name="approve-check" class="md3-color-picker__segment-check" aria-hidden="true" />
							<span class="md3-color-picker__segment-label">{labels.custom}</span>
						</span>
					</label>
				</div>
			</fieldset>

			<div class="md3-color-picker__custom-controls" data-md3-expanded="true" aria-hidden="false">
				<div class="md3-color-picker__custom-controls-inner">
					<div class="md3-color-picker__custom-controls-body">
						<div class="md3-color-picker__seed-field">
							<span>{labels.seed}</span>
							<div class="md3-color-picker__color-editor">
								<div
									class="md3-color-picker__sv"
									role="slider"
									tabindex="0"
									aria-label={labels.colorArea}
									aria-valuemin="0"
									aria-valuemax="100"
									aria-valuenow="100"
									data-saturation-label={labels.saturation}
									data-brightness-label={labels.brightness}
								>
									<span class="md3-color-picker__sv-thumb" aria-hidden="true"></span>
								</div>
								<div class="md3-color-picker__hue-row">
									<span class="md3-color-picker__preview" aria-hidden="true"></span>
									<input
										class="md3-color-picker__hue"
										type="range"
										min="0"
										max="359"
										step="1"
										aria-label={labels.hue}
									/>
								</div>
								<div class="md3-color-picker__hex-field">
									<input
										class="md3-color-picker__hex"
										type="text"
										inputmode="text"
										maxlength="7"
										spellcheck="false"
										aria-label={`${labels.seed} hex`}
									/>
								</div>
							</div>
							<span class="md3-color-picker__hex-error" role="status" hidden>{labels.invalid}</span>
						</div>

						<fieldset class="md3-color-picker__group md3-color-picker__variant-group">
							<legend>{labels.variant}</legend>
							<div class="md3-color-picker__segments md3-color-picker__segments--variant">
								<label>
									<input type="radio" name="md3-color-variant" value="tonalSpot" />
									<span>
										<Icon name="approve-check" class="md3-color-picker__segment-check" aria-hidden="true" />
										<span class="md3-color-picker__segment-label">{labels.tonalSpot}</span>
									</span>
								</label>
								<label>
									<input type="radio" name="md3-color-variant" value="expressive" />
									<span>
										<Icon name="approve-check" class="md3-color-picker__segment-check" aria-hidden="true" />
										<span class="md3-color-picker__segment-label">{labels.expressive}</span>
									</span>
								</label>
								<label>
									<input type="radio" name="md3-color-variant" value="content" />
									<span>
										<Icon name="approve-check" class="md3-color-picker__segment-check" aria-hidden="true" />
										<span class="md3-color-picker__segment-label">{labels.content}</span>
									</span>
								</label>
							</div>
						</fieldset>
					</div>
				</div>
			</div>
		</div>

		<footer class="md3-color-picker__actions">
			<button type="button" class="md3-color-picker__reset">{labels.reset}</button>
			<span class="md3-color-picker__action-spacer"></span>
			<button type="button" class="md3-color-picker__cancel">{labels.cancel}</button>
			<button type="button" class="md3-color-picker__apply">{labels.apply}</button>
			<button type="button" class="md3-color-picker__copy">{labels.copy}</button>
		</footer>
	</dialog>

	<div class="md3-color-picker__toast" role="status" aria-live="polite" hidden>{labels.copied}</div>
</starlight-md3-color-picker>

<script>
	import { generateClientSeedColorScheme } from '../client-palette.js';
	import { normalizeHexSeed, type Md3GeneratedColorScheme, type Md3SeedVariant } from '../palette-core.js';

	type ColorSource = 'custom' | 'default';
	type PickerMode = 'author' | 'visitor';
	type HsvColor = { hue: number; saturation: number; value: number };
	type PickerConfig = {
		mode: PickerMode;
		persist: boolean;
		deployedSeed: string;
		deployedVariant: Md3SeedVariant;
		storageKey: string;
	};
	type Snapshot = {
		seed: string | null;
		style: string | null;
		source: string | null;
		variant: string | null;
	};

	declare global {
		interface Window {
			__starlightThemeMd3ColorPicker?: PickerConfig;
		}
	}

	const runtimeStyleId = 'starlight-theme-md3-runtime-colors';
	const variants: Md3SeedVariant[] = ['tonalSpot', 'expressive', 'content'];
	const clamp = (value: number, min = 0, max = 1) => Math.min(max, Math.max(min, value));

	function hexToHsv(hex: string, fallbackHue = 0): HsvColor {
		const normalized = normalizeHexSeed(hex) ?? '#000000';
		const red = Number.parseInt(normalized.slice(1, 3), 16) / 255;
		const green = Number.parseInt(normalized.slice(3, 5), 16) / 255;
		const blue = Number.parseInt(normalized.slice(5, 7), 16) / 255;
		const max = Math.max(red, green, blue);
		const min = Math.min(red, green, blue);
		const delta = max - min;
		let hue = fallbackHue;

		if (delta > 0) {
			if (max === red) hue = 60 * (((green - blue) / delta) % 6);
			else if (max === green) hue = 60 * ((blue - red) / delta + 2);
			else hue = 60 * ((red - green) / delta + 4);
		}

		return {
			hue: (hue + 360) % 360,
			saturation: max === 0 ? 0 : delta / max,
			value: max,
		};
	}

	function hsvToHex({ hue, saturation, value }: HsvColor) {
		const chroma = value * saturation;
		const hueSection = ((hue % 360) + 360) % 360 / 60;
		const intermediate = chroma * (1 - Math.abs((hueSection % 2) - 1));
		const offset = value - chroma;
		let red = 0;
		let green = 0;
		let blue = 0;

		if (hueSection < 1) [red, green] = [chroma, intermediate];
		else if (hueSection < 2) [red, green] = [intermediate, chroma];
		else if (hueSection < 3) [green, blue] = [chroma, intermediate];
		else if (hueSection < 4) [green, blue] = [intermediate, chroma];
		else if (hueSection < 5) [red, blue] = [intermediate, chroma];
		else [red, blue] = [chroma, intermediate];

		return `#${[red, green, blue]
			.map((channel) => Math.round((channel + offset) * 255).toString(16).padStart(2, '0'))
			.join('')}`;
	}

	class StarlightMd3ColorPicker extends HTMLElement {
		private config: PickerConfig | undefined;
		private dialog: HTMLDialogElement | null = null;
		private snapshot: Snapshot | null = null;
		private source: ColorSource = 'default';
		private seed = '#006a62';
		private variant: Md3SeedVariant = 'tonalSpot';
		private color: HsvColor = { hue: 174, saturation: 1, value: 0.42 };
		private closeTimer = 0;
		private closeTransitionCleanup: (() => void) | null = null;
		private previewFrame = 0;
		private toastTimer = 0;

		connectedCallback() {
			if (this.dataset.md3Ready === 'true') return;
			this.config = window.__starlightThemeMd3ColorPicker;
			this.dialog = this.querySelector<HTMLDialogElement>('.md3-color-picker__dialog');
			if (!this.config || !this.dialog) return;

			this.dataset.md3Ready = 'true';
			this.dataset.md3Mode = this.config.mode;
			this.seed = normalizeHexSeed(document.documentElement.dataset.md3ColorSeed ?? '') ?? this.config.deployedSeed;
			this.variant = this.parseVariant(document.documentElement.dataset.md3ColorVariant) ?? this.config.deployedVariant;
			this.source = this.config.mode === 'author'
				? 'custom'
				: this.parseSource(document.documentElement.dataset.md3ColorRuntime) ?? 'default';
			this.color = hexToHsv(this.seed, this.color.hue);

			this.syncControls();
			this.syncTrigger();
			this.addEventListeners();
			requestAnimationFrame(() => { this.dataset.md3SegmentsReady = 'true'; });
		}

		private addEventListeners() {
			this.querySelector('.md3-color-picker__trigger')?.addEventListener('click', () => this.open());
			this.querySelector('.md3-color-picker__close')?.addEventListener('click', () => this.close(false));
			this.querySelector('.md3-color-picker__cancel')?.addEventListener('click', () => this.close(false));
			this.querySelector('.md3-color-picker__reset')?.addEventListener('click', () => {
				this.source = 'default';
				this.preview();
				this.syncControls();
			});
			this.querySelector('.md3-color-picker__apply')?.addEventListener('click', () => this.apply());
			this.querySelector('.md3-color-picker__copy')?.addEventListener('click', () => this.copyConfig());

			this.querySelectorAll<HTMLInputElement>('input[name="md3-color-source"]').forEach((input) => {
				input.addEventListener('change', () => {
					this.source = this.parseSource(input.value) ?? 'default';
					this.preview();
					this.syncControls();
				});
			});

			this.querySelectorAll<HTMLInputElement>('input[name="md3-color-variant"]').forEach((input) => {
				input.addEventListener('change', () => {
					this.variant = this.parseVariant(input.value) ?? this.variant;
					this.preview();
					this.syncControls();
				});
			});

			const hex = this.querySelector<HTMLInputElement>('.md3-color-picker__hex');
			this.addColorEditorListeners();
			hex?.addEventListener('input', () => {
				const value = normalizeHexSeed(hex.value);
				hex.setAttribute('aria-invalid', String(!value));
				const error = this.querySelector<HTMLElement>('.md3-color-picker__hex-error');
				if (error) error.hidden = Boolean(value);
				if (!value) return;
				this.seed = value;
				this.source = 'custom';
				this.color = hexToHsv(value, this.color.hue);
				this.preview();
				this.syncControls(false);
			});

			this.dialog?.addEventListener('cancel', (event) => {
				event.preventDefault();
				this.close(false);
			});
			this.dialog?.addEventListener('click', (event) => {
				if (event.target === this.dialog) this.close(false);
			});
		}

		private addColorEditorListeners() {
			const colorArea = this.querySelector<HTMLElement>('.md3-color-picker__sv');
			const hue = this.querySelector<HTMLInputElement>('.md3-color-picker__hue');
			if (!colorArea || !hue) return;

			const updateFromPointer = (event: PointerEvent) => {
				const rect = colorArea.getBoundingClientRect();
				this.color.saturation = clamp((event.clientX - rect.left) / rect.width);
				this.color.value = clamp(1 - (event.clientY - rect.top) / rect.height);
				this.updateSeedFromColor();
			};

			colorArea.addEventListener('pointerdown', (event) => {
				event.preventDefault();
				colorArea.setPointerCapture(event.pointerId);
				updateFromPointer(event);
			});
			colorArea.addEventListener('pointermove', (event) => {
				if (colorArea.hasPointerCapture(event.pointerId)) updateFromPointer(event);
			});
			colorArea.addEventListener('pointerup', (event) => {
				if (colorArea.hasPointerCapture(event.pointerId)) colorArea.releasePointerCapture(event.pointerId);
			});
			colorArea.addEventListener('keydown', (event) => {
				const step = event.shiftKey ? 0.1 : 0.01;
				switch (event.key) {
					case 'ArrowLeft':
						this.color.saturation = clamp(this.color.saturation - step);
						break;
					case 'ArrowRight':
						this.color.saturation = clamp(this.color.saturation + step);
						break;
					case 'ArrowDown':
						this.color.value = clamp(this.color.value - step);
						break;
					case 'ArrowUp':
						this.color.value = clamp(this.color.value + step);
						break;
					default:
						return;
				}
				event.preventDefault();
				this.updateSeedFromColor();
			});

			hue.addEventListener('input', () => {
				this.color.hue = Number(hue.value);
				this.updateSeedFromColor();
			});
		}

		private updateSeedFromColor() {
			this.seed = hsvToHex(this.color);
			this.source = 'custom';
			this.syncControls();
			this.queuePreview();
		}

		private queuePreview() {
			if (this.previewFrame) return;
			this.previewFrame = requestAnimationFrame(() => {
				this.previewFrame = 0;
				this.preview();
			});
		}

		private open() {
			if (!this.dialog || this.dialog.open) return;
			this.clearCloseTransition();
			this.snapshot = this.captureSnapshot();
			this.source = this.config?.mode === 'author'
				? (this.parseSource(document.documentElement.dataset.md3ColorRuntime) ?? 'custom')
				: (this.parseSource(document.documentElement.dataset.md3ColorRuntime) ?? 'default');
			this.seed = normalizeHexSeed(document.documentElement.dataset.md3ColorSeed ?? '') ?? this.config!.deployedSeed;
			this.variant = this.parseVariant(document.documentElement.dataset.md3ColorVariant) ?? this.config!.deployedVariant;
			this.color = hexToHsv(this.seed, this.color.hue);
			this.syncControls();
			this.dialog.dataset.md3DialogState = 'opening';
			this.dialog.showModal();
			this.querySelector<HTMLButtonElement>('.md3-color-picker__trigger')?.setAttribute('aria-expanded', 'true');
			requestAnimationFrame(() => requestAnimationFrame(() => this.dialog?.setAttribute('data-md3-dialog-state', 'open')));
		}

		private close(commit: boolean) {
			if (!this.dialog?.open || this.dialog.dataset.md3DialogState === 'closing') return;
			if (!commit) this.restoreSnapshot();
			this.clearCloseTransition();
			const finish = () => {
				this.clearCloseTransition();
				this.dialog?.close();
				this.dialog?.removeAttribute('data-md3-dialog-state');
				this.querySelector<HTMLButtonElement>('.md3-color-picker__trigger')?.setAttribute('aria-expanded', 'false');
				this.querySelector<HTMLButtonElement>('.md3-color-picker__trigger')?.focus();
			};

			const closeDuration = this.getCloseDuration();
			if (closeDuration === 0) {
				finish();
				return;
			}

			this.dialog.dataset.md3DialogState = 'closing';
			const onTransitionEnd = (event: TransitionEvent) => {
				if (event.target === this.dialog && event.propertyName === 'transform') finish();
			};
			this.dialog.addEventListener('transitionend', onTransitionEnd);
			this.closeTransitionCleanup = () => this.dialog?.removeEventListener('transitionend', onTransitionEnd);
			this.closeTimer = window.setTimeout(finish, closeDuration + 80);
		}

		private clearCloseTransition() {
			window.clearTimeout(this.closeTimer);
			this.closeTimer = 0;
			this.closeTransitionCleanup?.();
			this.closeTransitionCleanup = null;
		}

		private getCloseDuration() {
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return 0;
			return matchMedia('(max-width: 49.99rem)').matches ? 200 : 150;
		}

		private preview() {
			if (this.source === 'default') {
				this.clearRuntimeScheme();
			} else {
				const scheme = generateClientSeedColorScheme(this.seed, this.variant);
				this.applyRuntimeScheme(scheme, this.source);
			}
			this.syncTrigger();
			this.syncApplyState();
		}

		private apply() {
			if (!this.config) return;
			if (this.source === 'default') {
				this.clearRuntimeScheme();
				this.persistScheme();
			} else {
				const scheme = generateClientSeedColorScheme(this.seed, this.variant);
				this.applyRuntimeScheme(scheme, this.source);
				this.persistScheme({
					version: 1,
					source: this.source,
					seed: this.seed,
					variant: this.variant,
					...scheme,
				});
			}
			this.snapshot = this.captureSnapshot();
			this.close(true);
		}

		private persistScheme(value?: Record<string, unknown>) {
			if (!this.config?.persist) return;

			try {
				if (value) localStorage.setItem(this.config.storageKey, JSON.stringify(value));
				else localStorage.removeItem(this.config.storageKey);
			} catch {
				// Keep runtime color changes usable when storage is unavailable.
			}
		}

		private async copyConfig() {
			const value = this.source === 'default'
				? 'md3Theme()'
				: `md3Theme({ seed: '${this.seed}', variant: '${this.variant}' })`;
			try {
				await navigator.clipboard.writeText(value);
				this.showToast();
				this.snapshot = this.captureSnapshot();
				this.close(true);
			} catch {
				// Keep the dialog open when clipboard permission is unavailable.
			}
		}

		private applyRuntimeScheme(scheme: Md3GeneratedColorScheme, source: Exclude<ColorSource, 'default'>) {
			let style = document.getElementById(runtimeStyleId) as HTMLStyleElement | null;
			if (!style) {
				style = document.createElement('style');
				style.id = runtimeStyleId;
				document.head.append(style);
			}
			style.textContent = this.renderScheme(scheme);
			document.documentElement.dataset.md3ColorRuntime = source;
			document.documentElement.dataset.md3ColorSeed = this.seed;
			document.documentElement.dataset.md3ColorVariant = this.variant;
		}

		private clearRuntimeScheme() {
			document.getElementById(runtimeStyleId)?.remove();
			delete document.documentElement.dataset.md3ColorRuntime;
			delete document.documentElement.dataset.md3ColorSeed;
			delete document.documentElement.dataset.md3ColorVariant;
		}

		private renderScheme(scheme: Md3GeneratedColorScheme) {
			const tokens = (values: Record<string, string>) =>
				Object.entries(values).map(([name, color]) => `--md-sys-color-${name}:${color};`).join('');
			return `:root[data-md3-color-runtime]{${tokens(scheme.dark)}}:root[data-md3-color-runtime][data-theme="light"]{${tokens(scheme.light)}}`;
		}

		private captureSnapshot(): Snapshot {
			return {
				style: document.getElementById(runtimeStyleId)?.textContent ?? null,
				source: document.documentElement.dataset.md3ColorRuntime ?? null,
				seed: document.documentElement.dataset.md3ColorSeed ?? null,
				variant: document.documentElement.dataset.md3ColorVariant ?? null,
			};
		}

		private restoreSnapshot() {
			if (!this.snapshot) return;
			if (this.snapshot.style) {
				let style = document.getElementById(runtimeStyleId) as HTMLStyleElement | null;
				if (!style) {
					style = document.createElement('style');
					style.id = runtimeStyleId;
					document.head.append(style);
				}
				style.textContent = this.snapshot.style;
			} else {
				document.getElementById(runtimeStyleId)?.remove();
			}
			this.restoreDataset('md3ColorRuntime', this.snapshot.source);
			this.restoreDataset('md3ColorSeed', this.snapshot.seed);
			this.restoreDataset('md3ColorVariant', this.snapshot.variant);
			this.source = this.parseSource(this.snapshot.source) ?? 'default';
			this.seed = normalizeHexSeed(this.snapshot.seed ?? '') ?? this.config?.deployedSeed ?? this.seed;
			this.variant = this.parseVariant(this.snapshot.variant) ?? this.config?.deployedVariant ?? this.variant;
			this.color = hexToHsv(this.seed, this.color.hue);
			this.syncTrigger();
		}

		private restoreDataset(name: 'md3ColorRuntime' | 'md3ColorSeed' | 'md3ColorVariant', value: string | null) {
			if (value) document.documentElement.dataset[name] = value;
			else delete document.documentElement.dataset[name];
		}

		private syncControls(syncHex = true) {
			this.querySelectorAll<HTMLInputElement>('input[name="md3-color-source"]').forEach((input) => {
				input.checked = input.value === this.source;
			});
			this.querySelectorAll<HTMLInputElement>('input[name="md3-color-variant"]').forEach((input) => {
				input.checked = input.value === this.variant;
			});
			const hex = this.querySelector<HTMLInputElement>('.md3-color-picker__hex');
			if (hex && syncHex) {
				hex.value = this.seed.toUpperCase();
				hex.setAttribute('aria-invalid', 'false');
				const error = this.querySelector<HTMLElement>('.md3-color-picker__hex-error');
				if (error) error.hidden = true;
			}
			const customControls = this.querySelector<HTMLElement>('.md3-color-picker__custom-controls');
			if (customControls) {
				const expanded = this.source === 'custom';
				customControls.dataset.md3Expanded = String(expanded);
				customControls.setAttribute('aria-hidden', String(!expanded));
				customControls.inert = !expanded;
			}
			this.syncSegmentIndicator('.md3-color-picker__segments--source', this.source);
			this.syncSegmentIndicator('.md3-color-picker__segments--variant', this.variant);
			this.syncColorEditor();
			this.syncApplyState();
		}

