			group.style.setProperty('--md3-segment-count', String(inputs.length));
			group.style.setProperty('--md3-segment-index', String(index));
			group.dataset.md3SegmentPosition = index === 0 ? 'first' : index === inputs.length - 1 ? 'last' : 'middle';
